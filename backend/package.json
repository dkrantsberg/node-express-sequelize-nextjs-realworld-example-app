{
  "name": "conduit-node-backend",
  "version": "1.0.0",
  "description": "Conduit RealWorld Express + Sequelize JSON API",
  "main": "app.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--unhandled-rejections=strict' nodemon",
    "dev-pg": "REALWORLD_PG=true npm run dev",
    "dev-demo": "DEMO=true npm run dev",
    "start": "node --import tsx --unhandled-rejections=strict ./app.ts",
    "sync-db": "tsx bin/sync-db.ts",
    "seed": "tsx bin/generate-demo-data.ts",
    "test": "NODE_ENV=test mocha",
    "test-pg": "REALWORLD_PG=true npm test --",
    "tsc": "tsc",
    "format": "prettier --write ."
  },
  "license": "ISC",
  "dependencies": {
    "commander": "12.1.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-jwt": "8.5.1",
    "express-session": "1.18.1",
    "jsonwebtoken": "9.0.2",
    "method-override": "3.0.0",
    "morgan": "1.10.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.13.1",
    "sequelize": "6.37.5",
    "slug": "0.9.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/method-override": "0.0.35",
    "@types/mocha": "10.0.10",
    "@types/morgan": "1.9.9",
    "@types/node": "20.17.11",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "mocha": "10.8.2",
    "nodemon": "3.1.9",
    "prettier": "2.5.1",
    "sequelize-cli": "6.6.2",
    "sqlite3": "5.1.7",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true
  }
}
