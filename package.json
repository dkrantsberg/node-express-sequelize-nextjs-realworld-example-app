{
  "name": "conduit-node",
  "version": "1.0.0",
  "description": "conduit on node",
  "main": "app.ts",
  "scripts": {
    "back-test": "NODE_ENV=test npm run dev",
    "build": "tsx bin/sync-db.ts && next build",
    "build-dev": "tsx bin/sync-db.ts && NEXT_PUBLIC_NODE_ENV=development npm run build",
    "build-prod": "./prod.sh tsx bin/sync-db.ts && ./prod.sh npm run build",
    "deploy": "npm run test-next && npm run test-pg-next && git push -f heroku-next next:master && git push && git push origin next:deploy",
    "dev": "NODE_OPTIONS='--unhandled-rejections=strict' nodemon",
    "dev-demo": "NEXT_PUBLIC_DEMO=true npm run dev",
    "dev-pg": "REALWORLD_PG=true npm run dev",
    "format": "prettier --ignore-path .prettierignore --write .",
    "lint": "next lint",
    "seed-prod": "./prod.sh tsx bin/generate-demo-data.ts --force-production",
    "start": "node --import tsx --unhandled-rejections=strict ./app.ts",
    "start-dev": "NEXT_PUBLIC_NODE_ENV=development NODE_ENV_NEXT_SERVER_ONLY=production node --import tsx --unhandled-rejections=strict ./app.ts",
    "start-prod": "./prod.sh npm start",
    "test": "NODE_ENV=test mocha",
    "test-api": "./realworld/api/run-api-tests.sh",
    "test-next": "npm run build-dev && npm run test-next-nobuild",
    "test-next-nobuild": "NODE_ENV_NEXT_SERVER_ONLY=production REALWORLD_TEST_NEXT=true npm test -- --timeout 100000",
    "test-pg": "REALWORLD_PG=true npm test --",
    "test-pg-next": "npm run build-dev && REALWORLD_PG=true NODE_ENV_NEXT_SERVER_ONLY=production REALWORLD_TEST_NEXT=true npm test -- --timeout 100000",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gothinkster/productionready-node-api.git"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "1.7.9",
    "commander": "12.1.0",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-jwt": "8.5.1",
    "express-session": "1.18.1",
    "ionicons": "2.0.1",
    "jsonwebtoken": "9.0.2",
    "marked": "1.1.1",
    "method-override": "3.0.0",
    "morgan": "1.10.0",
    "next": "12.0.7",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.13.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "sequelize": "6.37.5",
    "slug": "0.9.1",
    "swr": "0.3.0",
    "termit": "0.4.4",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@fontsource/source-sans-pro": "4.5.0",
    "@fontsource/source-serif-pro": "4.5.0",
    "@fontsource/titillium-web": "4.5.0",
    "@next/eslint-plugin-next": "12.0.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/gtag.js": "0.0.7",
    "@types/jsonwebtoken": "9.0.7",
    "@types/method-override": "0.0.35",
    "@types/mocha": "10.0.10",
    "@types/morgan": "1.9.9",
    "@types/node": "20.17.11",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/react": "17.0.38",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "8.5.0",
    "eslint-config-next": "12.0.7",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-prettier": "4.0.0",
    "mocha": "10.8.2",
    "newman": "5.2.3",
    "nodemon": "3.1.9",
    "prettier": "2.5.1",
    "sass": "1.34.0",
    "sequelize-cli": "6.6.2",
    "sqlite3": "5.1.7",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true
  },
  "cacheDirectories": [
    "node_modules"
  ]
}
